# ===========================================
# Whisper Money - Production Environment
# ===========================================
# Copy this file to .env and configure for your production environment

# ========================================
# CORE APPLICATION (Required)
# ========================================
APP_NAME="Whisper Money"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_KEY=  # Auto-generated on first startup if empty

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ========================================
# DATABASE (Required)
# ========================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=whisper_money
DB_USERNAME=whisper_money
DB_PASSWORD=your-secure-password

# MySQL root password (for Docker setup)
MYSQL_ROOT_PASSWORD=your-secure-root-password

# ========================================
# CACHE & SESSIONS (Required)
# ========================================
# Redis runs inside the container - no external service needed
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ========================================
# QUEUE (Required)
# ========================================
QUEUE_CONNECTION=database

# ========================================
# EMAIL (Optional - Required for password resets)
# ========================================
# For local installations, use MAIL_MAILER=log (logs emails to storage/logs)
# For production, use Resend (recommended) or SMTP

# Resend (Recommended for production - 3,000 free emails/month)
MAIL_MAILER=resend
RESEND_API_KEY=your-resend-api-key
MAIL_FROM_ADDRESS=hi@your-domain.com
MAIL_FROM_NAME="Whisper Money"

# Alternative: SMTP (Gmail, Mailgun, etc.)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

# ========================================
# STRIPE SUBSCRIPTIONS (Optional)
# ========================================
# Set SUBSCRIPTIONS_ENABLED=true to enable premium subscriptions
SUBSCRIPTIONS_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ========================================
# FEATURES (Optional)
# ========================================
# Hide login/register buttons on landing page
HIDE_AUTH_BUTTONS=false

# Enable drip emails (welcome, onboarding, feedback)
DRIP_EMAILS_ENABLED=false

# Demo account (leave empty to disable)
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_ENCRYPTION_KEY=

# ========================================
# ERROR TRACKING (Optional)
# ========================================
# Sentry for error monitoring (https://sentry.io)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
