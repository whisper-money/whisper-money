{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "sentry": {
            "type": "http",
            "url": "https://mcp.sentry.dev/mcp"
        },
        "posthog": {
            "enabled": false,
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote@latest",
                "https://mcp.posthog.com/mcp"
            ]
        }
    }
}