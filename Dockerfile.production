# syntax=docker/dockerfile:1
# Pinned to the patch release so a cached base image cannot ship an unpatched PHP
FROM php:8.5.12-fpm

ARG SENTRY_RELEASE
# CI sets this so a failed source map upload fails the image build instead of
# shipping bundles whose debug IDs Sentry has never seen.
ARG SENTRY_UPLOAD_REQUIRED=false

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libicu-dev \
    zip \
    unzip \
    nginx \
    supervisor \
    libmemcached-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip intl
# Build memcached and redis from their GitHub release sources so a PECL outage cannot block a deploy
RUN docker-php-source extract \
    && mkdir -p /usr/src/php/ext/memcached /usr/src/php/ext/redis \
    && curl -fsSL https://github.com/php-memcached-dev/php-memcached/archive/refs/tags/v3.4.0.tar.gz | tar xz --strip-components=1 -C /usr/src/php/ext/memcached \
    && curl -fsSL https://github.com/phpredis/phpredis/archive/refs/tags/6.3.0.tar.gz | tar xz --strip-components=1 -C /usr/src/php/ext/redis \
    && docker-php-ext-install memcached redis \
    && docker-php-source delete

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Install Bun in a non-root path so supervisor workers running as www-data can execute it
ENV BUN_INSTALL="/usr/local/bun"
RUN curl -fsSL https://bun.com/install | bash \
    && ln -sf /usr/local/bun/bin/bun /usr/local/bin/bun \
    && chmod -R a+rx /usr/local/bun
ENV PATH="/usr/local/bun/bin:${PATH}"

# Install memcached and redis servers
RUN apt-get update && apt-get install -y memcached redis-server && rm -rf /var/lib/apt/lists/*

# MySQL client: Laravel shells out to it to load database/schema/mysql-schema.sql
# when migrating an empty database (fresh self-hosted install)
RUN apt-get update && apt-get install -y --no-install-recommends default-mysql-client && rm -rf /var/lib/apt/lists/*
COPY docker/mysql/client.cnf /etc/mysql/conf.d/whisper-client.cnf

# Set working directory
WORKDIR /app

ENV SENTRY_RELEASE=${SENTRY_RELEASE}

# Copy dependency manifests first so Docker can reuse install layers across code changes
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader

COPY package.json bun.lock ./
COPY scripts ./scripts
RUN bun install --frozen-lockfile

# Chromium for the shareable monthly-summary cards. They are a Blade view
# photographed by headless Chromium, because the alternative was redrawing five
# designs in three formats with GD and watching them drift from the design on the
# first change. Playwright is already a dependency of the Pest browser suite, so
# this is the browser the tests run on rather than a second stack.
#
# The binary lands in a shared path so the queue workers, which run as www-data,
# can execute it.
ENV PLAYWRIGHT_BROWSERS_PATH="/usr/local/playwright"
RUN bunx playwright install --with-deps chromium \
    && chmod -R a+rx /usr/local/playwright

# Copy application files
COPY . /app/.
RUN composer dump-autoload --no-dev --optimize

# Create necessary directories
RUN mkdir -p /var/log/nginx && mkdir -p /var/cache/nginx

# Build assets with HIDE_AUTH_BUTTONS=false so Wayfinder generates all routes
# (HIDE_AUTH_BUTTONS will be set to true at runtime via .env)
#
# The Sentry auth token arrives as a BuildKit secret (`--secret id=sentry_auth_token`),
# never as an ARG/ENV, so it is not stored in any image layer or in the history.
# With it, vite.config.ts emits hidden source maps, uploads them and deletes them.
# Without it, the build is unchanged: no maps, no upload. The final find is a
# guard so a map can never be served from public/build, even if an upload fails
# before the plugin deletes them.
RUN --mount=type=secret,id=sentry_auth_token,env=SENTRY_AUTH_TOKEN \
    HIDE_AUTH_BUTTONS=false bun run build:ssr \
    && find public/build bootstrap/ssr -name '*.map' -delete

# Copy supervisor configuration
COPY docker/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/fastcgi_params /etc/nginx/fastcgi_params

# Copy php-fpm pool and PHP production overrides
COPY docker/php/zz-www-pool.conf /usr/local/etc/php-fpm.d/zz-www-pool.conf
COPY docker/php/zz-production.ini /usr/local/etc/php/conf.d/zz-production.ini

# Set permissions
RUN chown -R www-data:www-data /app \
    && chmod -R 755 /app/storage \
    && chmod -R 755 /app/bootstrap/cache

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost/up || exit 1

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Run entrypoint script (handles migrations, caching, then starts supervisor)
CMD ["/entrypoint.sh"]
